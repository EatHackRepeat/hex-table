        printf("%d", offset + pointer);

        fseek(file, offset, SEEK_SET);
        fread(buf, 1, 256, file);


        //print hex dump
        i = 0;
        for (y = 7; y < 23; y++)//print hex dump
        {
            for (x = 9; x < 55; x += 3)
            {
                gotoxy(x, y);
                textcolor(192);
                _cprintf("%0.2x", buf[i]);
                i++;
            }
        }

        //print ASCII dump
        i = 0;
        for (y = 7; y < 23; y++)//print ASCII dump
        {
            for (x = 64; x < 80; x ++)
            {
                gotoxy(x, y);
                textcolor(176);
                if (buf[i] <= 32 || buf[i] == 0)
                {
                    _cprintf(".");
                }
                else
                {
                    _cprintf("%c", buf[i]);
                }

                i++;
            }
        }
    }
    //gotoxy(x, y);
    //textcolor(192);
    //cout << " ";
}//end of the paint function

unsigned long getlen()//get size of file in bytes
{
    unsigned long len = 0;
    if (file != NULL)
    {
        fseek(file, 0, SEEK_SET);
        while (fgetc(file) != EOF) len++;
    }
    return len;
}

void closefile()
{
    if (file != NULL) fclose(file);
    sprintf_s(cfilename, "no file");
    file = NULL;
}


int main(void)
{
    offset = 0;//in nibbles of 16 bytes
    pointer = 0;//in multiples of 16
    size1 = 0;//opened file zie
    int i=0, x=0, y=0;
    char fname[256];//temp store of user input filename to open
    update = 1;//do we update screen? who knows its a mystery

    showcursor(false);
    sprintf_s(cfilename, "nofile");
    print();

    while (!done)//display loop
    {
        //if (update == 1)//refresh screen
        //{
        //    update = 0;
        //    print();
        //}
        key = _getch();//get keyboard input

        if (key == VK_ESCAPE) done = 1;//exit program

        if (key == 59)//F1 load file
        {
            clrscr();
            textcolor(12);
            gotoxy(1, 25);
            _cprintf("Open file > ");
            cin >> fname;

            sprintf_s(cfilename, fname);
            fopen_s(&file, cfilename, "rb+");
            size1 = getlen();
            print();
        }

        if (key == 77) //Right Arrow 
        {
            print();
            x++;
            gotoxy(x, y);
            textcolor(208);
            cout << " ";
        }
        if (key == 75) //Left Arrow 
        {
            print();
            x--;
            gotoxy(x, y);
            textcolor(208);
            cout << " ";
        }
        if (key == 72) //Up Arrow 
        {
            print();
            y--;
            gotoxy(x, y);
            textcolor(208);
            cout << " ";
        }
        if (key == 80) //Down Arrow 
        {
            print();
            y++;
            gotoxy(x, y);
            textcolor(208);
            cout << " ";
        }


        textcolor(14);
        gotoxy(1, 26);
        _cprintf("%d", key);

    }
    textcolor(15);
    clrscr();
    return 0;
}//end of main

void textcolor(int c)
{
    HANDLE  hConsole;
    hConsole = GetStdHandle(STD_OUTPUT_HANDLE);
    SetConsoleTextAttribute(hConsole, c);
}

void gotoxy(int x, int y)         //define gotoxy function
{
    static HANDLE hStdout = NULL;
    COORD coord;

    coord.X = x;
    coord.Y = y;
    if (!hStdout) { hStdout = GetStdHandle(STD_OUTPUT_HANDLE); }
    SetConsoleCursorPosition(hStdout, coord);
}

void clrscr(void)
{
    static HANDLE hStdout = NULL;
    static CONSOLE_SCREEN_BUFFER_INFO csbi;
    const COORD startCoords = { 0,0 };
    DWORD dummy;
    textcolor(10);

    if (!hStdout)
    {
        hStdout = GetStdHandle(STD_OUTPUT_HANDLE);
        GetConsoleScreenBufferInfo(hStdout, &csbi);
    }
    FillConsoleOutputCharacter(hStdout, ' ', csbi.dwSize.X * csbi.dwSize.Y, startCoords, &dummy);
    gotoxy(0, 0);
    //Clear screen after images from moving cursor
    for (y = 0; y < 32; y++)
    {
        for (x = 0; x < 82; x++)
        {
            gotoxy(x, y);
            textcolor(10);
            cout << " ";
        }
    }
    gotoxy(0, 0);
}

void showcursor(bool showFlag)
{
    HANDLE out = GetStdHandle(STD_OUTPUT_HANDLE);

    CONSOLE_CURSOR_INFO     cursorInfo;

    GetConsoleCursorInfo(out, &cursorInfo);
    cursorInfo.bVisible = showFlag;// set the cursor visibility
    SetConsoleCursorInfo(out, &cursorInfo);
}

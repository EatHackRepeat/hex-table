        "\n"
        "         00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F        0123456789ABCDEF\n"
        "   0000:                                                       0\n"
        "   0010:                                                       1\n"
        "   0020:                                                       2\n"
        "   0030:                                                       3\n"
        "   0040:                                                       4\n"
        "   0050:                                                       5\n"
        "   0060:                                                       6\n"
        "   0070:                                                       7\n"
        "   0080:                                                       8\n"
        "   0090:                                                       9\n"
        "   00A0:                                                       A\n"
        "   00B0:                                                       B\n"
        "   00C0:                                                       C\n"
        "   00D0:                                                       D\n"
        "   00E0:                                                       E\n"
        "   00F0:                                                       F\n");
    // this is the output screen, when program loaded with data program will print to here. 

    gotoxy(0, 0);
    textcolor(10);
    cout << "[Editing: " << cfilename << "]";

    if (file != NULL)//did we find the file? did we? who knows?!!
    {
        gotoxy(0, 0);
        textcolor(10);
